# .dockerignore for the commit-image build.
# Goal: bake in the FULL repo (including .git history — the grader uses it),
# dropping only local build artifacts. Dev image, not minimal.

# ── meson build outputs (build.sh creates these fresh; don't ship stale ones) ──
build/
build-fuzz/
build-test/
*.o
*.a
*.so
*.so.*

# ── Editor / OS noise ────────────────────────────────────────────────────────
.DS_Store
*.swp
*~
