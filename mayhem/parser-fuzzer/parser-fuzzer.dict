# .pc keyword/variable-language dictionary for pkgconf's parser-fuzzer.
# Tokens are the reserved keywords, operators, and interpolation syntax that
# libpkgconf/parser.c recognizes in a .pc file; seeding them lets the fuzzer
# reach deeper parser states (variable expansion, version comparisons,
# continuation lines) much faster than random bytes would.
"Name:"
"Version:"
"Description:"
"URL:"
"Requires:"
"Requires.private:"
"Requires.internal:"
"Conflicts:"
"Provides:"
"Cflags:"
"Cflags.private:"
"Libs:"
"Libs.private:"
"prefix="
"exec_prefix="
"libdir="
"includedir="
"${"
"}"
"="
"\\\x0A"
"\x09"
" "
">="
"<="
"=="
"!="
">"
"<"
","
"#"
