# .pc keyword dictionary for pkgconf's spdxtool-fuzzer. The harness splits the
# input on NUL bytes into up to 4 named packages (a.pc..d.pc) and solves the
# dependency graph rooted at "a" — so besides the usual .pc keywords, the NUL
# separator and the a/b/c/d package names themselves are high-value tokens.
"\x00"
"a"
"b"
"c"
"d"
"Name:"
"Version:"
"Description:"
"URL:"
"Requires:"
"Requires.private:"
"Requires.internal:"
"Conflicts:"
"Provides:"
"Cflags:"
"Cflags.private:"
"Libs:"
"Libs.private:"
"${"
"}"
"="
">="
"<="
"=="
"!="
">"
"<"
","
